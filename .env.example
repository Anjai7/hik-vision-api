# Hikvision Terminal Host Configuration
# For local network: https://192.168.18.229
# For Public IP + Port Forwarding: https://YOUR_PUBLIC_IP:PORT (e.g. https://103.45.67.89:8443)
# Or with Dynamic DNS domain: https://myoffice.ddns.net:8443
HIKVISION_HOST=https://192.168.18.229
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=change_me
HIKVISION_VERIFY_TLS=false
HIKVISION_TIMEOUT=12000

# Server Configuration
PORT=4000
NODE_ENV=development

# Optional: Protect API from unauthorized public calls (pass x-api-key in React Native header)
# Leave empty if you don't want API key authentication
API_SECRET_KEY=
